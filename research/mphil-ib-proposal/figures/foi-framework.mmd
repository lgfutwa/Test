    IC["Cross-border internationalisation capabilities<br/><small>Financial-operational capability<br/>Regulatory-adaptation capability<br/>Network-mobilisation capability<br/>Opportunity-enactment capability</small>"]
    IO["Internationalisation outcomes<br/><small>Entry speed · International scope<br/>International intensity<br/>Post-entry persistence & growth</small>"]
